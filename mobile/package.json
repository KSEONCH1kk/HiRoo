{
  "name": "hiroo-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "HiRoo mobile app (Android / iOS) via Capacitor",
  "scripts": {
    "init": "cap init HiRoo tech.intave.hiroo --web-dir=www",
    "add:android": "cap add android",
    "add:ios": "cap add ios",
    "sync": "cap sync",
    "android": "cap open android",
    "ios": "cap open ios",
    "build:android": "cap copy android && cd android && gradlew assembleRelease",
    "icons:render": "electron build-assets.js",
    "icons": "npm run icons:render && capacitor-assets generate"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/app": "^6.0.1",
    "@capacitor/core": "^6.1.2",
    "@capacitor/haptics": "^6.0.1",
    "@capacitor/keyboard": "^6.0.2",
    "@capacitor/local-notifications": "^6.1.0",
    "@capacitor/push-notifications": "^6.0.2",
    "@capacitor/splash-screen": "^6.0.2",
    "@capacitor/status-bar": "^6.0.1",
    "@capawesome-team/capacitor-android-foreground-service": "^6.2.0",
    "@capacitor-mlkit/barcode-scanning": "^6.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2",
    "@capacitor/assets": "^3.0.5",
    "electron": "^33.0.0"
  }
}
