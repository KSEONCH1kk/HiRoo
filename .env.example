# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=hiroo
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=hiroo
DATABASE_URL=postgresql+asyncpg://hiroo:change_me_in_production@localhost:5432/hiroo

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change_me_in_production
REDIS_URL=redis://:change_me_in_production@localhost:6379/0

# ── JWT Secrets (generate with: openssl rand -hex 32) ────────────────────────
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
REFRESH_SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","https://yourdomain.com"]

# ── Environment ──────────────────────────────────────────────────────────────
ENVIRONMENT=production
LOG_LEVEL=INFO

# ── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://yourdomain.com
NEXT_PUBLIC_WS_URL=wss://yourdomain.com
